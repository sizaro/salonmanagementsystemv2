# Development only. Mock payments are blocked when NODE_ENV=production.
PAYMENTS_MODE=mock
# Set PAYMENTS_MODE=manual only for controlled bank payouts when a live bank
# payout adapter is not enabled. Manual payouts require owner/manager verification.
MOCK_PAYMENT_DELAY_MS=2500
PAYMENT_RECOVERY_INTERVAL_MS=30000

# Keep disabled until the bank has issued Uganda-specific credentials and the
# normalized notification mapping has been certified against its live schema.
BANK_NOTIFICATIONS_ENABLED=false
BANK_WEBHOOK_SECRET=
